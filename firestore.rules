rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the authenticated user can read/write their own document
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      // Update: only allow user-editable profile fields (server writes via Admin SDK bypass rules)
      allow update: if request.auth != null && request.auth.uid == userId
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['firstName', 'lastName', 'phone', 'phoneCountryCode',
                                 'country', 'city', 'grade', 'bio', 'photoURL',
                                 'linkedIn', 'instagram', 'twitter', 'referralCode',
                                 'onboardingCompleted', 'onboardingStatus']);
      allow create: if request.auth != null && request.auth.uid == userId
                    // Prevent users from self-assigning privileged fields
                    && !('role' in request.resource.data)
                    && !('plan' in request.resource.data)
                    && !('subscriptionStatus' in request.resource.data);
      allow delete: if false;

      // Children subcollection
      match /children/{childId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null && request.auth.uid == userId
                              && request.resource.data.keys().hasOnly(['name', 'age', 'ageBand',
                                   'blockedUrls', 'blockedKeywords', 'allowedUrls', 'createdAt', 'updatedAt'])
                              && request.resource.data.name is string
                              && request.resource.data.age is number;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Notifications subcollection
      match /notifications/{notificationId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        // Only server creates notifications; clients can read/delete
        allow create, update: if false;
      }
    }

    // Report history: only the owning user can access
    match /report-history/{reportId} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Pay collection: only server-side writes (via Admin SDK which bypasses rules)
    match /pay/{docId} {
      allow read, write: if false;
    }

    // Processed webhook events: server-only
    match /processed_webhook_events/{eventId} {
      allow read, write: if false;
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
