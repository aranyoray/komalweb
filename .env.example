# KOMAL URL Safety Demo - Environment Variables

# ==============================================
# GOOGLE CLOUD CONFIGURATION
# ==============================================

# Option 1: API Key Authentication (Easiest for testing)
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key-here

# Option 2: Service Account Authentication (Production)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
# GOOGLE_CLOUD_PROJECT_ID=your-project-id

# ==============================================
# GOOGLE CUSTOM SEARCH API (For Keyword Analysis)
# ==============================================

# Used for searching articles and images when analyzing keywords (non-URL queries)
# Setup:
# 1. Go to https://programmablesearchengine.google.com/
# 2. Create a new search engine (set to "Search the entire web")
# 3. Get the Search Engine ID (cx parameter)
# 4. Go to https://console.cloud.google.com/apis/credentials
# 5. Create an API key with Custom Search API enabled

GOOGLE_CUSTOM_SEARCH_API_KEY=your-custom-search-api-key-here
GOOGLE_CUSTOM_SEARCH_ENGINE_ID=your-search-engine-id-here

# ==============================================
# EMAIL CONFIGURATION (Nodemailer)
# ==============================================

# SMTP Host (e.g., smtp.gmail.com, smtp.office365.com, smtp.sendgrid.net)
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL)
SMTP_PORT=587

# Set to "true" for SSL (port 465), leave empty or "false" for TLS (port 587)
SMTP_SECURE=false

# SMTP Authentication
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# From Address for emails
SMTP_FROM="KOMAL" <noreply@komalkids.com>

# ==============================================
# NOTES
# ==============================================

# Google Cloud Setup:
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable Cloud Vision API and Cloud Natural Language API
# 3. Create an API key or service account
# 4. See DEMO_SETUP.md for detailed instructions

# Gmail SMTP Setup:
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an App Password at https://myaccount.google.com/apppasswords
# 3. Use the app password as SMTP_PASS
# 4. Use your Gmail address as SMTP_USER

# Other Email Providers:
# - SendGrid: Use smtp.sendgrid.net, port 587, API key as password
# - Office 365: Use smtp.office365.com, port 587
# - Amazon SES: Use email-smtp.region.amazonaws.com
