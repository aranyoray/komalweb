# ==============================================
# EMAIL CONFIGURATION (Nodemailer) - GoDaddy/Titan
# ==============================================

SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true

SMTP_USER=play@komalkids.com
SMTP_PASS=your_smtp_password_here

# IMPORTANT: keep FROM the same as SMTP_USER to avoid deliverability issues
SMTP_FROM="KOMAL" <play@komalkids.com>

# ==============================================
# STRIPE CONNECT CONFIGURATION
# ==============================================
# Get your API keys from: https://dashboard.stripe.com/apikeys

# Your Stripe Secret Key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Webhook Secret for V2 thin events (connected accounts)
# Get this from the Stripe Dashboard > Developers > Webhooks
STRIPE_WEBHOOK_SECRET_V2=whsec_your_v2_webhook_secret_here

# Webhook Secret for subscription events (platform account)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Your application's base URL (used for return URLs)
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# Platform subscription price ID (create this in Stripe Dashboard)
# Used for charging subscriptions to connected accounts
STRIPE_PLATFORM_PRICE_ID=price_your_platform_price_id_here

# ==============================================
# FIREBASE CONFIGURATION
# ==============================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_firebase_client_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
