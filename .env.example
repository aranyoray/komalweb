# Google Cloud Platform Configuration
# =====================================
# Choose ONE of the following authentication methods:

# Method 1: API Key (Recommended for testing)
# Get your API key from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key-here

# Method 2: Service Account (Recommended for production)
# Path to your service account JSON key file
# Download from: https://console.cloud.google.com/iam-admin/serviceaccounts
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Google Cloud Project Configuration (Optional)
# GOOGLE_CLOUD_PROJECT_ID=your-project-id

# Note: If neither GOOGLE_CLOUD_API_KEY nor GOOGLE_APPLICATION_CREDENTIALS is set,
# the system will run in demo mode with pattern-based analysis only.
